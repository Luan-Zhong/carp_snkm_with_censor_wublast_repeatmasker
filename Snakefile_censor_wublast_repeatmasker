# Set input genome here
# e.g.: genome file "X.fa"
# Set preFix = ["X"]
preFix = config.get("preFix")
if isinstance(preFix, str):
    preFix = [preFix]

# Read the directory containing genome FASTA files
# Example: "data" means that test_input uses data/test_input.fa
INPUT_DIR = config["input_dir"].rstrip("/") + "/"

# Read the directory used for all pipeline outputs
# rstrip("/") removes an existing trailing slash before adding exactly one
OUTDIR = config["output_dir"].rstrip("/") + "/"

# Read the maximum number of threads used by multithreaded tools
MAX_THREADS = config["max_threads"]

# Read the maximum number of bases placed in one genome bundle
BUNDLE_SIZE = config["bundle_size"]

# Read the minimum Krishna alignment identity
# Example: 0.94 means at least 94 percent identity
KRISHNA_FILTID = config["krishna_filter_identity"]

# Read the minimum Krishna alignment length in bases
# Example: 400 means that alignments shorter than 400 bases are filtered
KRISHNA_FILTLEN = config["krishna_filter_length"]

# Read the maximum number of sequences used for one Seqer repeat family
SEQER_MAX_FAMILY_SIZE = config["seqer_max_family_size"]

# Read the minimum retained sequence-length proportion used by Seqer
# Example: 0.95 means at least 95 percent of the expected length
SEQER_MIN_LENGTH = config["seqer_min_length"]

# Control whether RepeatMasker genome annotation is requested
ANNOTATE_GENOME = config["annotate_genome"]
if not isinstance(ANNOTATE_GENOME, bool):
    raise ValueError(
        "[ERROR] annotate_genome must be true or false"
    )

# Control whether the final HTML report is requested
MAKE_REPORT = config["make_report"]
if not isinstance(MAKE_REPORT, bool):
    raise ValueError(
        "[ERROR] make_report must be true or false"
    )
# Control whether consensus annotation plots are requested
PLOT_CONSENSUS_MAP = config["plot_consensus_map"]

if not isinstance(PLOT_CONSENSUS_MAP, bool):
    raise ValueError(
        "[ERROR] plot_consensus_map must be true or false"
    )


# Read the consensus IDs selected for plotting
# YAML lists become Python lists
# Example: [family1, family2] becomes ["family1", "family2"]
PLOT_CONSENSUS_IDS = config["plot_consensus_ids"]

if not isinstance(PLOT_CONSENSUS_IDS, list):
    raise ValueError(
        "[ERROR] plot_consensus_ids must be a YAML list"
    )

# Plotting requires at least one ID when enabled
if PLOT_CONSENSUS_MAP and not PLOT_CONSENSUS_IDS:
    raise ValueError(
        "[ERROR] plot_consensus_ids must not be empty when plot_consensus_map is true"
    )

# Require every selected value to be one non-empty string
if any(
    not isinstance(consensus_id, str)
    or not consensus_id
    or "," in consensus_id
    for consensus_id in PLOT_CONSENSUS_IDS
):
    raise ValueError(
        "[ERROR] plot_consensus_ids must contain non-empty IDs without commas"
    )

# all must be used alone because it already represents every consensus
if "all" in PLOT_CONSENSUS_IDS and len(PLOT_CONSENSUS_IDS) != 1:
    raise ValueError(
        "[ERROR] all cannot be combined with individual consensus IDs"
    )

# Convert the YAML list into the single comma-separated R argument
# Example: ["family1", "family2"] becomes "family1,family2"
PLOT_CONSENSUS_IDS_ARGUMENT = ",".join(
    PLOT_CONSENSUS_IDS
)

# Return no annotation dependency when genome annotation is disabled
def optional_genome_annotation(wildcards):
    if not ANNOTATE_GENOME:
        return []

    # Return the stage 12 directory when annotation is enabled
    return (
        OUTDIR
        + f"{wildcards.prefix}/12_genome_annotation"
    )

# Return no plot dependency when consensus plotting is disabled
def optional_consensus_plots(wildcards):
    if not PLOT_CONSENSUS_MAP:
        return []

    # Return the stage 13 plot directory when plotting is enabled
    return (
        OUTDIR
        + f"{wildcards.prefix}/13_consensus_plots"
    )

# Always request the stage 11 annotated de novo repeat library
FINAL_OUTPUTS = expand(
    OUTDIR
    + "{prefix}/11_generate_annotated_repeat_lib/{prefix}_Denovo_TE_Library.fasta",
    prefix=preFix,
)

# Add the RepeatMasker output directory only when annotation is enabled
if ANNOTATE_GENOME:
    FINAL_OUTPUTS.extend(
        expand(
            OUTDIR + "{prefix}/12_genome_annotation",
            prefix=preFix,
        )
    )

# Add the consensus plot directory only when plotting is enabled
if PLOT_CONSENSUS_MAP:
    FINAL_OUTPUTS.extend(
        expand(
            OUTDIR + "{prefix}/13_consensus_plots",
            prefix=preFix,
        )
    )

# Add the HTML report only when report generation is enabled
if MAKE_REPORT:
    FINAL_OUTPUTS.extend(
        expand(
            OUTDIR + "{prefix}/{prefix}_CARP_snkm_report.html",
            prefix=preFix,
        )
    )

onstart:
    print("#################################\n### Starting CARP... ><(((('> ###\n#################################\n")
    shell("mkdir -p {OUTDIR}")

# Use singularity local contianer
# singularity exec lib/CARP_05_w_repeatmasker_R.sif which RepeatMasker and R packages
singularity: "src/CARP_05_w_repeatmasker_R.sif"


# Set output file inside expand function to run seleted step
rule all:
    input:
        FINAL_OUTPUTS



