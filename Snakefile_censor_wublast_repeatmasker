        protein=$(realpath {input.protein})
        known=$(realpath {input.known})
        library=$(realpath -m {output.library})
        log=$(realpath -m {output.log})

        cd lib

        java -cp ../src GenerateAnnotatedLibrary_CARP_snkm \
            "$consensus" \
            "$consensus_map" \
            "$te_gff" \
            "$gb_te" \
            "$erv_gff" \
            "$retrovirus" \
            "$ssr" \
            "$protein" \
            "$known" \
            "$library" \
            > "$log" 2>&1
        echo "================== Check TE library results in {params.out_dir} =================="
        """

rule annotate_genome:
    input:
        repbase = config["repbase_library"],
        denovo = OUTDIR + "{prefix}/11_generate_annotated_repeat_lib/{prefix}_Denovo_TE_Library.fasta",
        mfa_file = OUTDIR + "{prefix}/03_seqer/{prefix}.mfa"
    output:
        directory(OUTDIR + "{prefix}/12_genome_annotation")
    params:
        thrd = MAX_THREADS,
        out_dir = OUTDIR + "{prefix}/12_genome_annotation",
    shell:
        """
        echo "================== Annotate genome by RepeatMasker =================="
        mkdir -p {params.out_dir}
        combined="{params.out_dir}/{wildcards.prefix}_combined_library2.fa"
        cat {input.repbase} {input.denovo} > "$combined"
        env FAMDB_DIR= RepeatMasker -engine rmblast -pa 16 -a -nolow -norna -dir {params.out_dir} -lib "$combined" {input.mfa_file}
        echo "================== Check genome annotation result in {params.out_dir} ================== "
        """

rule plot_consensus_map:
    input:
        # R script that reads the Censor map and WU-BLAST reports
        script = "src/plot_censor_wublast_map.R",

        # Consensus sequences determine plot IDs and sequence lengths
        consensus = (
            OUTDIR
            + "{prefix}/04_finalize_consensus/{prefix}_ConsensusSequences.fa"
        ),

        # Censor provides RepBase and our-known annotations
        map = (
            OUTDIR
            + "{prefix}/05_repeats_in_repbase/{prefix}_ConsensusSequences.fa.map"
        ),

        # The FASTA files identify the exact source of each map reference
        repbase = config["repbase_library"],
        our_known = config["our_known_library"],

        # Use the original WU-BLAST reports because their GFF files
        # do not retain identity or bit score
        swissprot = rules.filter_sequences.output.protein,
        gb_te = rules.filter_sequences.output.gb_te,
        retrovirus = rules.filter_sequences.output.retrovirus

    output:
        plot_dir = directory(
            OUTDIR + "{prefix}/13_consensus_plots"
        )

    params:
        # Pass all or one comma-separated consensus ID string to R
        consensus_ids = PLOT_CONSENSUS_IDS_ARGUMENT

    log:
        OUTDIR
        + "{prefix}/13_consensus_plots/{prefix}_plot_consensus_map.log"
    shell:
        """
        mkdir -p "{output.plot_dir}"

        exec > >(tee "{log}") 2>&1

        echo Running on `hostname`
        echo Start time is `date`
        trap 'echo End time is `date`' EXIT

        /opt/r/bin/Rscript "{input.script}" \
            "{input.consensus}" \
            "{input.map}" \
            "{input.repbase}" \
            "{input.our_known}" \
            "{input.swissprot}" \
            "{input.gb_te}" \
            "{input.retrovirus}" \
            "{output.plot_dir}" \
